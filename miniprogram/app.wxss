page {
  background-color: #f7f8fa;
  color: #1f2329;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  box-sizing: border-box;
}

view, text, image, input, textarea, button {
  box-sizing: border-box;
}

.orange {
  color: #ff6a00;
}

.bg-orange {
  background-color: #ff6a00;
}

.muted {
  color: #8d949c;
  font-size: 24rpx;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 22rpx;
  border: 1rpx solid #eceef2;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
}

.pill {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #fff2e8;
  color: #f46a26;
  font-size: 22rpx;
  font-weight: 600;
}

.primary-btn {
  background: linear-gradient(135deg, #ff7e1d 0%, #ff5200 100%);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 20rpx rgba(255, 95, 0, 0.28);
}

.primary-btn::after {
  border: none;
}
