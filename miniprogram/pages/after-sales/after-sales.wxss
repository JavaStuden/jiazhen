page {
  background-color: #f7f8fa;
  min-height: 100vh;
}

.container {
  padding: 20rpx 28rpx 60rpx;
}

.mode-switch-bar {
  display: flex;
  background: #ffffff;
  border-radius: 999rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #eceef2;
}

.m-pill {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 25rpx;
  color: #646a73;
  border-radius: 999rpx;
}

.m-pill.active {
  background: #ff6a00;
  color: #ffffff;
  font-weight: 700;
}

.card {
  background: #ffffff;
  border-radius: 26rpx;
  padding: 28rpx;
  margin-bottom: 22rpx;
  border: 1rpx solid #eceef2;
}

.card-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #1f2329;
  margin-bottom: 20rpx;
}

.sub-hint {
  font-size: 22rpx;
  font-weight: 400;
  color: #8d949c;
  margin-left: 12rpx;
}

.order-brief {
  display: flex;
  align-items: center;
}

.ob-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.ob-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.ob-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.ob-tag {
  align-self: flex-start;
  background: #fff2e8;
  color: #ff6a00;
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
}

.ob-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #1f2329;
}

.ob-time {
  font-size: 23rpx;
  color: #8d949c;
}

.ob-right {
  text-align: right;
}

.ob-price {
  font-size: 36rpx;
  font-weight: 800;
  color: #ff6a00;
  display: block;
}

.ob-status {
  font-size: 23rpx;
  color: #19b37b;
  font-weight: 700;
}

.type-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.type-btn {
  position: relative;
  border: 2rpx solid #e5e6eb;
  border-radius: 18rpx;
  padding: 24rpx 20rpx;
  text-align: center;
  font-size: 27rpx;
  color: #1f2329;
  font-weight: 600;
}

.type-btn.active {
  border-color: #ff6a00;
  background: #fff8f3;
  color: #ff6a00;
}

.type-check {
  position: absolute;
  right: 14rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: #ff6a00;
  color: #ffffff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.desc-box {
  width: 100%;
  height: 180rpx;
  background: #f8f9fb;
  border-radius: 18rpx;
  padding: 20rpx;
  font-size: 26rpx;
}

.upload-row {
  display: flex;
  gap: 18rpx;
}

.upload-box {
  width: 160rpx;
  height: 160rpx;
  border: 2rpx dashed #c4c8d0;
  border-radius: 18rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #8d949c;
  font-size: 38rpx;
}

.upload-box text {
  font-size: 22rpx;
  margin-top: 6rpx;
}

.uploaded-thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 18rpx;
}

.kv-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f2f4f7;
}

.kv-row.last-kv {
  border-bottom: none;
  padding-bottom: 0;
}

.kv-lbl {
  font-size: 27rpx;
  color: #4e5969;
  display: block;
}

.kv-sub {
  font-size: 21rpx;
  color: #8d949c;
  display: block;
  margin-top: 4rpx;
}

.kv-val {
  font-size: 27rpx;
  color: #1f2329;
  font-weight: 600;
}

.kv-price {
  font-size: 34rpx;
  font-weight: 800;
  color: #ff6a00;
}

.guarantee-box {
  background: #fff8f3;
  border-radius: 22rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.g-icon {
  font-size: 42rpx;
  margin-right: 18rpx;
}

.g-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #1f2329;
  display: block;
}

.g-sub {
  font-size: 23rpx;
  color: #7b8390;
}

.submit-full-btn {
  width: 100%;
  height: 94rpx;
  line-height: 94rpx;
}

/* 售后进度（PDF 第 26 页） */
.progress-hero {
  background: linear-gradient(135deg, #f3f7ff 0%, #e8f0fe 100%);
  display: flex;
  align-items: center;
}

.ph-icon {
  font-size: 56rpx;
  margin-right: 22rpx;
}

.ph-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #1f2329;
  display: block;
}

.ph-sub {
  font-size: 25rpx;
  color: #4e5969;
  display: block;
  margin: 4rpx 0;
}

.ph-no {
  font-size: 22rpx;
  color: #8d949c;
}

.v-step {
  display: flex;
  align-items: flex-start;
  padding-bottom: 28rpx;
}

.v-step.last-v {
  padding-bottom: 0;
}

.v-dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #c4c8d0;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #ffffff;
}

.v-dot.green {
  background: #19b37b;
  border-color: #19b37b;
}

.v-dot.blue {
  background: #2b70c9;
  border-color: #2b70c9;
}

.v-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2329;
  display: block;
}

.v-time {
  font-size: 23rpx;
  color: #8d949c;
}

.blue-txt {
  color: #2b70c9;
  font-weight: 600;
}

.cs-msg {
  display: flex;
  align-items: flex-start;
}

.cs-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 18rpx;
}

.cs-txt {
  font-size: 26rpx;
  color: #333842;
  line-height: 1.45;
  display: block;
}

.cs-time {
  font-size: 22rpx;
  color: #8d949c;
  margin-top: 6rpx;
  display: block;
}

.dual-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 18rpx;
}

.outline-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  background: #ffffff;
  color: #ff6a00;
  border: 2rpx solid #ffb480;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 700;
  margin: 0;
}

.main-bar-btn {
  flex: 1.3;
  height: 88rpx;
  line-height: 88rpx;
  margin: 0;
}

.cancel-text-btn {
  background: #ffffff;
  color: #646a73;
  font-size: 26rpx;
  border-radius: 20rpx;
  height: 80rpx;
  line-height: 80rpx;
}

/* 评价服务（PDF 第 25 页） */
.star-card {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.star-heading {
  font-size: 36rpx;
  font-weight: 800;
  color: #1f2329;
  margin-bottom: 20rpx;
}

.stars-row {
  display: flex;
  gap: 22rpx;
  margin-bottom: 14rpx;
}

.star-ico {
  font-size: 64rpx;
  color: #dcdfe6;
}

.star-ico.lit {
  color: #ff8b1a;
}

.star-sub {
  font-size: 26rpx;
  color: #646a73;
  margin-bottom: 30rpx;
}

.left-align {
  align-self: flex-start;
}

.tag-wrap {
  width: 100%;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.rev-chip {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
  background: #f5f6f8;
  color: #646a73;
  border: 1rpx solid #e5e6eb;
}

.rev-chip.active {
  background: #fff2e8;
  color: #ff6a00;
  border-color: #ffb480;
  font-weight: 700;
}

.switch-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f2f4f7;
}

.switch-row.last-sw {
  border-bottom: none;
  padding-bottom: 0;
}

.sw-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2329;
  display: block;
}

.sw-sub {
  font-size: 22rpx;
  color: #8d949c;
}

.sw-sub-inline {
  font-size: 22rpx;
  color: #8d949c;
  font-weight: 400;
  margin-left: 10rpx;
}

.toggle-pill {
  width: 88rpx;
  height: 48rpx;
  border-radius: 999rpx;
  background: #dcdfe6;
  padding: 4rpx;
  display: flex;
  align-items: center;
}

.toggle-pill.on {
  background: #ff6a00;
  justify-content: flex-end;
}

.knob {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #ffffff;
}

/* 投诉与廉政举报（PDF 第 27 页） */
.comp-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.comp-box {
  border: 2rpx solid #e5e6eb;
  border-radius: 18rpx;
  padding: 22rpx 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.comp-box.active {
  border-color: #ff6a00;
  background: #fff8f3;
}

.comp-ico {
  font-size: 38rpx;
}

.comp-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #1f2329;
}

.target-tabs {
  display: flex;
  background: #f5f6f8;
  border-radius: 16rpx;
  padding: 6rpx;
  margin-bottom: 18rpx;
}

.t-tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 25rpx;
  color: #646a73;
  border-radius: 12rpx;
}

.t-tab.active {
  background: #ffffff;
  color: #ff6a00;
  font-weight: 700;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}
