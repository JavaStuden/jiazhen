<view class="container">
  <!-- 阶段一：确认并支付（对应 PDF 第 8 页 & 第 18 页） -->
  <block wx:if="{{step === 'confirm'}}">
    <view class="top-sub">费用拆分清晰，平台保障交易</view>

    <!-- 三步进度条 -->
    <view class="steps-box">
      <view class="step-item">
        <view class="step-circle done-circle"><text class="step-num">1</text></view>
        <text class="step-name">选择服务</text>
      </view>
      <view class="step-line active-line"></view>
      <view class="step-item">
        <view class="step-circle done-circle"><text class="step-num">2</text></view>
        <text class="step-name">填写需求</text>
      </view>
      <view class="step-line active-line"></view>
      <view class="step-item">
        <view class="step-circle active-circle"><text class="step-num active-num">3</text></view>
        <text class="step-name active-name">确认支付</text>
      </view>
    </view>

    <!-- 顶部已选套餐摘要卡 -->
    <view class="card pkg-summary-card">
      <image class="pkg-img" src="/images/package_thumb.jpg" mode="aspectFill"></image>
      <view class="pkg-info">
        <view class="pkg-cat-pill">{{draft.category}}</view>
        <view class="pkg-title-row">
          <text class="pkg-title">{{draft.serviceName}}</text>
          <text class="pkg-price">¥{{draft.amount}}</text>
        </view>
        <text class="pkg-meta">{{draft.scheduledAt}} · {{draft.area}}</text>
        <text class="pkg-meta">{{draft.address}}</text>
      </view>
    </view>

    <!-- 发布方式选择（整合 PDF 第 18 页） -->
    <view class="card">
      <view class="card-title">发布方式</view>
      <view class="mode-grid">
        <view 
          class="mode-box {{publishMode === 'standard' ? 'active' : ''}}"
          bindtap="selectPublishMode"
          data-mode="standard"
        >
          <view class="radio-dot {{publishMode === 'standard' ? 'checked' : ''}}"></view>
          <view class="mode-info">
            <text class="mode-name">标准发布</text>
            <text class="mode-sub">免费</text>
          </view>
        </view>
        <view 
          class="mode-box {{publishMode === 'urgent' ? 'active' : ''}}"
          bindtap="selectPublishMode"
          data-mode="urgent"
        >
          <view class="urgent-badge">优先曝光</view>
          <view class="radio-dot {{publishMode === 'urgent' ? 'checked' : ''}}"></view>
          <view class="mode-info">
            <text class="mode-name">付费加急</text>
            <text class="mode-sub orange-text">¥{{urgentFee}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 费用明细卡片（完全对应 PDF 第 8 页） -->
    <view class="card">
      <view class="card-title">费用明细</view>

      <view class="fee-row">
        <text class="fee-label">标准服务金额</text>
        <text class="fee-val">¥{{draft.amount}}.00</text>
      </view>

      <view class="fee-row">
        <view class="fee-left">
          <text class="fee-label">技术服务费</text>
          <text class="tech-pill">平台独立设置</text>
        </view>
        <text class="fee-val">¥{{draft.technicalFee || '9.90'}}</text>
      </view>

      <view class="tech-note">
        技术服务费由平台直接设置金额，不按比例计算，且不参与优惠券抵扣。
      </view>

      <view class="fee-divider"></view>

      <view class="fee-total-row">
        <text class="total-lbl">本次应付</text>
        <text class="total-num">¥{{payableTotal}}</text>
      </view>
    </view>

    <!-- 支付方式卡片 -->
    <view class="card">
      <view class="card-title">支付方式</view>
      <view class="pay-row" bindtap="selectPayment" data-method="wechat">
        <view class="pay-left">
          <view class="pay-icon wechat-bg">💬</view>
          <text class="pay-name">微信支付</text>
        </view>
        <view class="radio-circle {{paymentMethod === 'wechat' ? 'active' : ''}}"></view>
      </view>
    </view>

    <!-- 太禾行履约保障黑金卡 -->
    <view class="guarantee-card">
      <text class="guarantee-title">太禾行履约保障</text>
      <view class="guarantee-items">
        <text>✓ 平台担保</text>
        <text>✓ 服务留痕</text>
        <text>✓ 售后介入</text>
      </view>
    </view>

    <view class="bottom-placeholder"></view>

    <view class="bottom-bar">
      <view class="bottom-price">
        <text class="bottom-lbl">合计支付</text>
        <text class="bottom-val">¥{{payableTotal}}</text>
      </view>
      <button class="primary-btn pay-btn" bindtap="payAndPublish">
        支付并发布需求
      </button>
    </view>
  </block>

  <!-- 阶段二：发布成功与智能匹配推荐（对应 PDF 第 19 页） -->
  <block wx:else>
    <view class="card success-hero-card">
      <view class="success-icon">✓</view>
      <text class="success-title">需求发布成功</text>
      <text class="success-sub">已进入优先匹配队列</text>
      <view class="order-no-row">
        <text class="order-no-text">订单号 {{createdOrder.orderNo}}</text>
        <text class="urgent-tag" wx:if="{{publishMode === 'urgent'}}">付费加急</text>
      </view>
    </view>

    <!-- 智能匹配进度 -->
    <view class="card">
      <view class="card-title">智能匹配进度</view>
      <view class="match-steps">
        <view class="m-step done">
          <view class="m-dot green-dot">✓</view>
          <text class="m-title">已发布</text>
          <text class="m-time">刚刚</text>
        </view>
        <view class="m-line active"></view>
        <view class="m-step active">
          <view class="m-dot orange-dot">↻</view>
          <text class="m-title orange-text">智能匹配</text>
          <text class="m-time orange-text">匹配中...</text>
        </view>
        <view class="m-line"></view>
        <view class="m-step">
          <view class="m-dot"></view>
          <text class="m-title">服务人员接单</text>
          <text class="m-time">待接单</text>
        </view>
        <view class="m-line"></view>
        <view class="m-step">
          <view class="m-dot"></view>
          <text class="m-title">等待上门</text>
          <text class="m-time">待服务</text>
        </view>
      </view>
    </view>

    <!-- 匹配指标三栏 -->
    <view class="card match-stats-card">
      <view class="m-stat">
        <text class="m-stat-lbl">附近可匹配</text>
        <text class="m-stat-val">6人</text>
      </view>
      <view class="m-divider"></view>
      <view class="m-stat">
        <text class="m-stat-lbl">预计接单</text>
        <text class="m-stat-val">5分钟</text>
      </view>
      <view class="m-divider"></view>
      <view class="m-stat">
        <text class="m-stat-lbl">服务预算</text>
        <text class="m-stat-val">¥{{draft.amount}}</text>
      </view>
    </view>

    <!-- 订单摘要 -->
    <view class="card">
      <view class="card-title">订单摘要</view>
      <view class="summary-row">
        <view class="summary-left">
          <text class="s-line">🏠 {{draft.serviceName}}</text>
          <text class="s-line">📅 {{draft.scheduledAt}}</text>
          <text class="s-line">📍 {{draft.address}}</text>
        </view>
        <text class="summary-price">¥{{draft.amount}}</text>
      </view>
    </view>

    <!-- 为您推荐的服务人员 -->
    <view class="card">
      <view class="card-title">为您推荐的服务人员</view>
      <view 
        class="rec-provider" 
        wx:for="{{recommendProviders}}" 
        wx:key="id"
        bindtap="goProviderDetail"
        data-id="{{item.id}}"
      >
        <image class="rec-avatar" src="/images/logo.jpg" mode="aspectFill"></image>
        <view class="rec-main">
          <view class="rec-name-row">
            <text class="rec-name">{{item.name}}</text>
            <text class="rec-badge">{{item.badge}}</text>
            <text class="rec-skill">{{item.skills[0]}}</text>
          </view>
          <text class="rec-meta">信用分 {{item.creditScore}}分 · 距离您 {{item.distance}}</text>
        </view>
        <button class="rec-btn">查看资料</button>
      </view>
      <view class="privacy-tip">
        🛡️ 接单后将通过站内消息与隐私号联系，保障双方信息安全。
      </view>
    </view>

    <view class="bottom-placeholder"></view>

    <view class="bottom-bar dual-btns">
      <button class="cancel-outline-btn" bindtap="cancelPublishedOrder">取消需求</button>
      <button class="primary-btn view-order-btn" bindtap="goOrderDetail">查看订单</button>
    </view>
  </block>
</view>
