page {
  background-color: #f7f8fa;
  min-height: 100vh;
}

.container {
  padding: 16rpx 28rpx 80rpx;
}

.ops-tabs {
  white-space: nowrap;
  display: flex;
  margin-bottom: 22rpx;
}

.ops-tab {
  display: inline-block;
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #4e5969;
  font-size: 24rpx;
  margin-right: 14rpx;
  border: 1rpx solid #e5e6eb;
}

.ops-tab.active {
  background: #ff6a00;
  color: #ffffff;
  border-color: #ff6a00;
  font-weight: 700;
}

.orange-hero, .dark-hero {
  background: linear-gradient(135deg, #ff7e1d 0%, #e04f00 100%);
  border-radius: 28rpx;
  padding: 32rpx;
  color: #ffffff;
  margin-bottom: 22rpx;
}

.dark-hero {
  background: linear-gradient(135deg, #3b2212 0%, #9c4308 100%);
}

.oh-pill {
  display: inline-block;
  background: rgba(255, 255, 255, 0.22);
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  margin-bottom: 10rpx;
}

.oh-h1 {
  font-size: 38rpx;
  font-weight: 800;
  display: block;
  margin-bottom: 12rpx;
}

.oh-sub {
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.85);
  display: block;
}

.oh-big {
  font-size: 56rpx;
  font-weight: 800;
  display: block;
  margin: 8rpx 0 22rpx;
}

.oh-cols {
  display: flex;
  justify-content: space-between;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
}

.dark-cols {
  border-top-color: #f0f2f5;
  color: #1f2329;
}

.oh-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.oh-val {
  font-size: 32rpx;
  font-weight: 800;
  margin-top: 6rpx;
}

.card {
  background: #ffffff;
  border-radius: 26rpx;
  padding: 28rpx;
  margin-bottom: 22rpx;
  border: 1rpx solid #eceef2;
}

.card-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #1f2329;
  margin-bottom: 18rpx;
}

.kv-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f2f4f7;
}

.kv-row.last-kv, .kv-row.no-border {
  border-bottom: none;
  padding-bottom: 0;
}

.kv-lbl {
  font-size: 24rpx;
  color: #8d949c;
  display: block;
}

.kv-val {
  font-size: 27rpx;
  color: #1f2329;
  font-weight: 600;
}

.emp-row {
  display: flex;
  align-items: center;
}

.emp-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #fff2e8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 18rpx;
}

.thumb-sm {
  width: 96rpx;
  height: 96rpx;
  border-radius: 20rpx;
  margin-right: 18rpx;
}

.emp-main {
  flex: 1;
}

.emp-name {
  font-size: 30rpx;
  font-weight: 800;
  color: #1f2329;
  display: block;
}

.emp-tags {
  display: flex;
  gap: 10rpx;
  margin-top: 6rpx;
}

.green-pill {
  background: #e8f8f0;
  color: #19b37b;
  font-size: 21rpx;
  font-weight: 700;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

.orange-pill {
  background: #fff2e8;
  color: #ff6a00;
  font-size: 21rpx;
  font-weight: 700;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

.emp-num {
  font-size: 32rpx;
  font-weight: 800;
  color: #1f2329;
  margin-top: 6rpx;
}

.orange-big {
  font-size: 38rpx;
  font-weight: 800;
  color: #ff6a00;
}

.orange-txt {
  color: #ff6a00 !important;
  font-weight: 700;
}

.green-txt {
  color: #19b37b !important;
  font-weight: 700;
}

.bottom-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #ffffff;
  padding: 24rpx 30rpx;
  border-radius: 26rpx;
}

.bar-btn {
  width: 420rpx;
  margin: 0;
}

.full-btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
}

.map-card {
  background: linear-gradient(135deg, #eef7f2 0%, #dcece3 100%);
}

.map-route {
  font-size: 26rpx;
  font-weight: 700;
  color: #1f2329;
  margin-bottom: 14rpx;
}

.gps-pill {
  display: inline-block;
  background: #ffffff;
  color: #19b37b;
  font-size: 23rpx;
  font-weight: 700;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
}

.photo-grid {
  display: flex;
  gap: 18rpx;
  margin-bottom: 14rpx;
}

.door-photo {
  width: 240rpx;
  height: 170rpx;
  border-radius: 18rpx;
}

.add-photo-box {
  width: 240rpx;
  height: 170rpx;
  border: 2rpx dashed #c4c8d0;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8d949c;
  font-size: 26rpx;
}

.grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.grid-btn {
  border: 2rpx solid #e5e6eb;
  border-radius: 18rpx;
  padding: 22rpx 14rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
}

.grid-btn.active {
  border-color: #ff6a00;
  background: #fff8f3;
  color: #ff6a00;
}

.time-compare {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.tc-box {
  flex: 1;
  background: #f8f9fb;
  padding: 20rpx;
  border-radius: 16rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
}

.txt-area {
  width: 100%;
  height: 150rpx;
  background: #f8f9fb;
  border-radius: 16rpx;
  padding: 18rpx;
  font-size: 26rpx;
}

.withdraw-btn {
  background: #ffffff;
  color: #b34d08;
  font-size: 25rpx;
  font-weight: 800;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  margin: 0;
}

.chart-bars {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  height: 240rpx;
  padding-top: 24rpx;
}

.c-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
}

.c-val {
  font-size: 20rpx;
  color: #8d949c;
}

.c-bar-wrap {
  flex: 1;
  width: 24rpx;
  display: flex;
  align-items: flex-end;
  margin: 8rpx 0;
}

.c-bar {
  width: 100%;
  background: linear-gradient(180deg, #ff7e1d 0%, #ffd5b8 100%);
  border-radius: 999rpx;
}

.c-day {
  font-size: 21rpx;
  color: #646a73;
}

.toggle-pill {
  width: 88rpx;
  height: 48rpx;
  border-radius: 999rpx;
  background: #dcdfe6;
  padding: 4rpx;
  display: flex;
  align-items: center;
}

.toggle-pill.on {
  background: #ff6a00;
  justify-content: flex-end;
}

.knob {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #ffffff;
}
