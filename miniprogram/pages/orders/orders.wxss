page {
  background-color: #f7f8fa;
  min-height: 100vh;
}

.container {
  padding: 24rpx 28rpx 50rpx;
  box-sizing: border-box;
}

.header-row {
  margin-bottom: 24rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #1a2233;
  margin-bottom: 6rpx;
}

.page-sub {
  font-size: 24rpx;
  color: #8d949c;
}

/* 状态切换 Tabs */
.status-tabs {
  white-space: nowrap;
  display: flex;
  margin-bottom: 24rpx;
}

.tab-item {
  display: inline-block;
  padding: 12rpx 32rpx;
  font-size: 28rpx;
  color: #646a73;
  background: #ffffff;
  border-radius: 999rpx;
  margin-right: 18rpx;
  border: 1rpx solid #e5e6eb;
  transition: all 0.2s ease;
}

.tab-item.active {
  background: #ff6a00;
  color: #ffffff;
  border-color: #ff6a00;
  font-weight: 700;
  box-shadow: 0 4rpx 14rpx rgba(255, 106, 0, 0.25);
}

/* 订单卡片 */
.order-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.order-card {
  background: #ffffff;
  border-radius: 26rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid #eceef2;
}

.card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid #f3f5f8;
  margin-bottom: 18rpx;
}

.order-no {
  font-size: 24rpx;
  color: #8d949c;
}

.status-pill {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  background: #f2f4f7;
  color: #646a73;
}

.status-pill.active-pill {
  background: #e8f8f0;
  color: #19b37b;
}

.status-pill.pending-pill {
  background: #fff2e8;
  color: #ff6a00;
}

.service-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 14rpx;
}

.service-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a2233;
}

.service-price {
  font-size: 36rpx;
  font-weight: 800;
  color: #ff6a00;
}

.info-row {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.info-icon {
  font-size: 24rpx;
  margin-right: 12rpx;
  opacity: 0.7;
}

.info-text {
  font-size: 24rpx;
  color: #646a73;
}

.worker-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #f8f9fb;
  border-radius: 16rpx;
  padding: 14rpx 18rpx;
  margin: 16rpx 0 20rpx;
}

.worker-left {
  display: flex;
  align-items: center;
}

.worker-avatar-icon {
  font-size: 28rpx;
  margin-right: 10rpx;
}

.worker-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #1f2329;
  margin-right: 12rpx;
}

.worker-badge {
  font-size: 20rpx;
  color: #ff6a00;
  background: #fff0e5;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.worker-action {
  font-size: 24rpx;
  color: #ff6a00;
  font-weight: 600;
}

.card-bottom {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #f3f5f8;
}

.action-btn {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  margin: 0;
}

.action-btn::after {
  border: none;
}

.secondary-btn {
  background: #ffffff;
  color: #646a73;
  border: 1rpx solid #dcdfe6;
}

.main-btn {
  background: #ff6a00;
  color: #ffffff;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(255, 106, 0, 0.25);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
}

.empty-icon {
  font-size: 90rpx;
  margin-bottom: 24rpx;
  opacity: 0.4;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2329;
  margin-bottom: 8rpx;
}

.empty-sub {
  font-size: 24rpx;
  color: #8d949c;
  margin-bottom: 36rpx;
}

.empty-btn {
  background: #ff6a00;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  padding: 14rpx 48rpx;
  border-radius: 999rpx;
}
