<view class="home-page">
  <!-- 顶部定位与品牌导航（对应用户端 PDF 第 3 页） -->
  <view class="top-nav">
    <view class="brand-row" bindtap="goToLogin">
      <image class="brand-logo" src="/images/logo.jpg" mode="aspectFit"></image>
      <view class="brand-text-wrap">
        <text class="brand-title">太禾行</text>
        <text class="brand-sub">雇主端</text>
      </view>
    </view>
    <view class="city-pill" bindtap="switchCity">
      <image class="pin-img" src="/images/ico_pin.png" mode="aspectFit"></image>
      <text class="city-name">{{currentCity}}</text>
    </view>
  </view>

  <!-- 搜索栏 -->
  <view class="search-box" bindtap="goServices">
    <image class="search-img" src="/images/ico_search.png" mode="aspectFit"></image>
    <text class="search-text">搜索保洁、养老护理、上门维修</text>
    <view class="search-btn">搜索</view>
  </view>

  <!-- 首页大实景 Banner（对应 PDF 第 3 页） -->
  <view class="main-banner" bindtap="goServices">
    <image class="banner-full-img" src="/images/index_banner.jpg" mode="widthFix"></image>
  </view>

  <!-- 金刚区 8 大核心服务入口 -->
  <view class="grid-categories">
    <view 
      wx:for="{{categories}}" 
      wx:key="name" 
      class="cat-item"
      bindtap="onCategoryClick"
      data-name="{{item.name}}"
    >
      <image class="cat-img-box" src="{{item.img}}" mode="aspectFit"></image>
      <text class="cat-label">{{item.name}}</text>
    </view>
  </view>

  <!-- 新人专享优惠券橙色横幅（对应 PDF 第 3 页） -->
  <view class="coupon-banner" bindtap="claimCoupon">
    <view class="coupon-left">
      <text class="coupon-title">优惠活动</text>
      <text class="coupon-desc">优惠券活动暂未开放</text>
    </view>
    <button class="coupon-btn">立即领取</button>
  </view>

  <!-- 推荐服务明码标价区域 -->
  <view class="section-bar">
    <view class="section-left">
      <text class="section-heading">推荐服务</text>
    </view>
    <text class="section-more" bindtap="goServices">全部服务 ›</text>
  </view>

  <!-- 推荐套餐卡片列表 -->
  <view class="recommend-list">
    <view 
      wx:for="{{recommendList}}" 
      wx:key="id" 
      class="recommend-card"
      bindtap="goPackageDetail"
      data-id="{{item.id}}"
    >
      <image class="card-thumb" src="{{item.thumb || '/images/package_thumb.jpg'}}" mode="aspectFill"></image>
      <view class="card-body">
        <view class="card-title-row">
          <text class="card-title">{{item.name}}</text>
        </view>
        <text class="card-sub">{{item.subtitle}}</text>
        <view class="card-bottom">
          <view class="tags-row">
            <text class="tag-pill {{idx === 0 ? 'orange-pill' : 'blue-pill'}}" wx:for="{{item.tags}}" wx:for-item="tag" wx:for-index="idx" wx:key="*this">{{tag}}</text>
          </view>
          <view class="price-wrap">
            <text class="currency">¥</text>
            <text class="amount">{{item.price}}</text>
            <text class="unit">/次</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 悬浮快速“+ 发需求”按钮（对应原型底部中央橙色加号入口） -->
  <view class="fab-publish" bindtap="goServices">
    <text class="fab-plus">+</text>
    <text class="fab-label">发需求</text>
  </view>

</view>
