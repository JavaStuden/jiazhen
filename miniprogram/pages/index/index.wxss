page {
  background-color: #f7f8fa;
  min-height: 100vh;
}

.home-page {
  padding: 20rpx 28rpx 60rpx;
  box-sizing: border-box;
}

/* 顶部导航与品牌 */
.top-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 22rpx;
}

.brand-row {
  display: flex;
  align-items: center;
}

.brand-logo {
  width: 66rpx;
  height: 66rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  border: 2rpx solid #ffffff;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.08);
}

.brand-text-wrap {
  display: flex;
  flex-direction: column;
}

.brand-title {
  font-size: 38rpx;
  font-weight: 800;
  color: #ff6a00;
  line-height: 1.1;
}

.brand-sub {
  font-size: 22rpx;
  color: #8d949c;
  margin-top: 4rpx;
}

.city-pill {
  display: flex;
  align-items: center;
  background: #fff4ec;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
}

.pin-img {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
}

.city-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #7c3a12;
}

/* 搜索框 */
.search-box {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 24rpx;
  height: 84rpx;
  padding: 0 26rpx;
  border: 1rpx solid #eceef2;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03);
  margin-bottom: 24rpx;
}

.search-img {
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
}

.search-text {
  flex: 1;
  font-size: 26rpx;
  color: #8d949c;
}

.search-btn {
  color: #ff6a00;
  font-size: 28rpx;
  font-weight: 700;
}

/* 大横幅实景 Banner */
.main-banner {
  border-radius: 28rpx;
  overflow: hidden;
  margin-bottom: 26rpx;
  box-shadow: 0 10rpx 28rpx rgba(0, 0, 0, 0.08);
}

.banner-full-img {
  width: 100%;
  display: block;
}

/* 金刚区 8 大分类网格 */
.grid-categories {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24rpx 14rpx;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 30rpx 18rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #eceef2;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
}

.cat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.cat-img-box {
  width: 92rpx;
  height: 92rpx;
  border-radius: 24rpx;
  margin-bottom: 12rpx;
}

.cat-label {
  font-size: 25rpx;
  color: #1f2329;
  font-weight: 700;
}

/* 优惠券实心橙色横幅 */
.coupon-banner {
  background: linear-gradient(90deg, #ff8b2b 0%, #ff6a00 100%);
  border-radius: 24rpx;
  padding: 26rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 20rpx rgba(255, 106, 0, 0.24);
}

.coupon-left {
  display: flex;
  flex-direction: column;
}

.coupon-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #ffffff;
  margin-bottom: 6rpx;
}

.coupon-desc {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.88);
}

.coupon-btn {
  background: #ffffff;
  color: #ff6a00;
  font-size: 25rpx;
  font-weight: 700;
  padding: 12rpx 30rpx;
  border-radius: 999rpx;
  margin: 0;
  line-height: 1.4;
}

.coupon-btn::after {
  border: none;
}

/* 推荐小节标题 */
.section-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 22rpx;
}

.section-heading {
  font-size: 36rpx;
  font-weight: 800;
  color: #1a2233;
}

.section-more {
  font-size: 25rpx;
  color: #8d949c;
}

/* 推荐卡片 */
.recommend-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.recommend-card {
  background: #ffffff;
  border-radius: 26rpx;
  padding: 24rpx;
  display: flex;
  border: 1rpx solid #eceef2;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.04);
}

.card-thumb {
  width: 164rpx;
  height: 164rpx;
  border-radius: 20rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.card-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.card-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #1f2329;
}

.card-sub {
  font-size: 24rpx;
  color: #8d949c;
  margin: 6rpx 0 12rpx;
}

.card-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.tags-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.tag-pill {
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}

.orange-pill {
  background: #fff2e8;
  color: #ff6a00;
}

.blue-pill {
  background: #e8f8f0;
  color: #19b37b;
}

.price-wrap {
  display: flex;
  align-items: baseline;
  color: #ff6a00;
}

.currency {
  font-size: 26rpx;
  font-weight: 700;
}

.amount {
  font-size: 40rpx;
  font-weight: 800;
}

.unit {
  font-size: 22rpx;
  color: #ff6a00;
  margin-left: 2rpx;
}

/* 悬浮快速发需求按钮 */
.fab-publish {
  position: fixed;
  right: 32rpx;
  bottom: 32rpx;
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff7e1d 0%, #ff5200 100%);
  box-shadow: 0 10rpx 26rpx rgba(255, 95, 0, 0.38);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  z-index: 90;
}

.fab-plus {
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1;
}

.fab-label {
  font-size: 20rpx;
  font-weight: 700;
  margin-top: 2rpx;
}
