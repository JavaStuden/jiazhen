page {
  background-color: #f7f8fa;
  min-height: 100vh;
}

.home-page {
  padding: 24rpx 28rpx 50rpx;
  box-sizing: border-box;
}

/* 顶部导航与品牌 */
.top-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.brand-row {
  display: flex;
  align-items: center;
}

.brand-logo {
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  margin-right: 14rpx;
  border: 2rpx solid #ffffff;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.08);
}

.brand-text-wrap {
  display: flex;
  flex-direction: column;
}

.brand-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #1a2233;
  line-height: 1.1;
}

.brand-sub {
  font-size: 20rpx;
  color: #8d949c;
  margin-top: 2rpx;
}

.city-pill {
  display: flex;
  align-items: center;
  background: #ffffff;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  border: 1rpx solid #e3e6eb;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

.city-icon {
  font-size: 24rpx;
  margin-right: 6rpx;
}

.city-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2329;
}

.city-arrow {
  font-size: 20rpx;
  color: #8d949c;
  margin-left: 6rpx;
}

/* 搜索框 */
.search-box {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 24rpx;
  height: 82rpx;
  padding: 0 24rpx;
  border: 1rpx solid #eceef2;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03);
  margin-bottom: 24rpx;
}

.search-icon {
  font-size: 28rpx;
  opacity: 0.6;
  margin-right: 14rpx;
}

.search-text {
  flex: 1;
  font-size: 26rpx;
  color: #8d949c;
}

.search-btn {
  background: #ff6a00;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
}

/* 大横幅 Banner */
.main-banner {
  background: linear-gradient(135deg, #ff8c37 0%, #ff5200 100%);
  border-radius: 28rpx;
  padding: 38rpx 32rpx;
  color: #ffffff;
  position: relative;
  overflow: hidden;
  margin-bottom: 30rpx;
  box-shadow: 0 10rpx 28rpx rgba(255, 95, 0, 0.3);
}

.banner-badge {
  display: inline-block;
  background: rgba(255, 255, 255, 0.22);
  backdrop-filter: blur(8px);
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  margin-bottom: 14rpx;
  letter-spacing: 1rpx;
}

.banner-heading {
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.35;
  margin-bottom: 24rpx;
  letter-spacing: 1.5rpx;
}

.banner-action-btn {
  display: inline-block;
  background: #ffffff;
  color: #ff5e00;
  font-size: 26rpx;
  font-weight: 700;
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.12);
  line-height: 1.4;
  margin: 0;
}

.banner-action-btn::after {
  border: none;
}

/* 金刚区 8 大分类网格 */
.grid-categories {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 22rpx 14rpx;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 30rpx 18rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #eceef2;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
}

.cat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.cat-icon-wrap {
  width: 86rpx;
  height: 86rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.04);
}

.cat-icon {
  font-size: 40rpx;
}

.cat-label {
  font-size: 24rpx;
  color: #333842;
  font-weight: 500;
}

/* 优惠券横幅 */
.coupon-banner {
  background: linear-gradient(135deg, #fff4ec 0%, #ffe9dc 100%);
  border: 2rpx dashed #ffb480;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.coupon-left {
  display: flex;
  flex-direction: column;
}

.coupon-tag {
  display: inline-block;
  align-self: flex-start;
  background: #ff5200;
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 700;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  margin-bottom: 6rpx;
}

.coupon-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #e04f00;
  margin-bottom: 4rpx;
}

.coupon-desc {
  font-size: 21rpx;
  color: #a05a2e;
}

.coupon-btn {
  background: #ff5200;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 82, 0, 0.3);
  margin: 0;
  line-height: 1.4;
}

.coupon-btn::after {
  border: none;
}

/* 推荐小节标题 */
.section-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 22rpx;
}

.section-left {
  display: flex;
  align-items: center;
}

.section-indicator {
  width: 8rpx;
  height: 32rpx;
  background: #ff6a00;
  border-radius: 4rpx;
  margin-right: 14rpx;
}

.section-heading {
  font-size: 34rpx;
  font-weight: 800;
  color: #1a2233;
}

.section-more {
  font-size: 24rpx;
  color: #8d949c;
}

/* 推荐卡片 */
.recommend-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.recommend-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 22rpx;
  display: flex;
  border: 1rpx solid #eceef2;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.04);
}

.card-thumb {
  width: 170rpx;
  height: 160rpx;
  border-radius: 18rpx;
  margin-right: 22rpx;
  flex-shrink: 0;
}

.card-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.card-title-row {
  margin-bottom: 10rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2329;
}

.tags-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 14rpx;
}

.tag-pill {
  font-size: 20rpx;
  color: #7b8390;
  background: #f4f6f8;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.card-bottom {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.price-wrap {
  display: flex;
  align-items: baseline;
  color: #ff6a00;
}

.currency {
  font-size: 24rpx;
  font-weight: 700;
}

.amount {
  font-size: 38rpx;
  font-weight: 800;
}

.unit {
  font-size: 20rpx;
  color: #8d949c;
  margin-left: 2rpx;
}

.order-btn {
  background: #ff6a00;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 106, 0, 0.28);
  margin: 0;
  line-height: 1.4;
}

.order-btn::after {
  border: none;
}

.footer-tips {
  text-align: center;
  padding: 20rpx 0;
  font-size: 22rpx;
  color: #a4abb5;
}
