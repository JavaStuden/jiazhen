page {
  background-color: #f7f8fa;
  min-height: 100vh;
}

.worker-shell {
  min-height: 100vh;
}

.orange-header {
  background: linear-gradient(180deg, #ff6a00 0%, #e85a00 100%);
  padding: 24rpx 28rpx 34rpx;
  color: #ffffff;
  border-radius: 0 0 40rpx 40rpx;
}

.oh-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 26rpx;
}

.oh-brand {
  display: flex;
  align-items: center;
}

.oh-logo {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  margin-right: 14rpx;
  border: 2rpx solid #ffffff;
}

.oh-name {
  font-size: 36rpx;
  font-weight: 800;
  display: block;
  line-height: 1.1;
}

.oh-sub {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}

.switch-pill {
  background: rgba(255, 255, 255, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.45);
  padding: 10rpx 22rpx;
  border-radius: 16rpx;
  font-size: 23rpx;
  font-weight: 600;
}

.oh-worker {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}

.oh-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.8);
  margin-right: 22rpx;
}

.oh-greet {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  display: block;
}

.oh-headline {
  font-size: 40rpx;
  font-weight: 800;
  display: block;
  margin: 4rpx 0;
}

.oh-meta {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}

.oh-stats {
  background: rgba(0, 0, 0, 0.12);
  border-radius: 22rpx;
  padding: 22rpx 12rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.oh-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.oh-val {
  font-size: 34rpx;
  font-weight: 800;
  margin-bottom: 4rpx;
}

.oh-lbl {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}

.oh-div {
  width: 2rpx;
  height: 44rpx;
  background: rgba(255, 255, 255, 0.2);
}

.body-pad {
  padding: 24rpx 28rpx;
}

.top-pad {
  padding-top: 20rpx;
}

.remind-banner {
  background: #fff9eb;
  border: 1rpx solid #ffe5b4;
  border-radius: 22rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  margin-bottom: 26rpx;
}

.rb-ico {
  font-size: 38rpx;
  margin-right: 16rpx;
}

.rb-body {
  flex: 1;
}

.rb-title {
  font-size: 27rpx;
  font-weight: 800;
  color: #1f2329;
  display: block;
}

.rb-sub {
  font-size: 22rpx;
  color: #8d949c;
}

.rb-btn {
  background: #ffffff;
  color: #d46b08;
  font-size: 23rpx;
  font-weight: 700;
  padding: 10rpx 22rpx;
  border-radius: 14rpx;
  border: 1rpx solid #ffd591;
  margin: 0;
  line-height: 1.4;
}

.rb-btn::after {
  border: none;
}

.sec-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}

.no-mt {
  margin-top: 0;
}

.sec-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #1f2329;
}

.sec-refresh {
  font-size: 25rpx;
  color: #646a73;
}

.chip-row {
  display: flex;
  gap: 14rpx;
  margin-bottom: 22rpx;
  flex-wrap: wrap;
}

.f-chip {
  padding: 12rpx 26rpx;
  border-radius: 18rpx;
  background: #ffffff;
  color: #4e5969;
  font-size: 25rpx;
  border: 1rpx solid #e5e6eb;
}

.f-chip.active {
  background: #ff6a00;
  color: #ffffff;
  border-color: #ff6a00;
  font-weight: 700;
}

.card {
  background: #ffffff;
  border-radius: 26rpx;
  padding: 28rpx;
  margin-bottom: 22rpx;
  border: 1rpx solid #eceef2;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.03);
}

.gc-top, .so-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.gc-tags {
  display: flex;
  gap: 10rpx;
}

.gc-badge {
  font-size: 22rpx;
  font-weight: 700;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}

.green-tag {
  background: #e8f8f0;
  color: #19b37b;
}

.orange-tag {
  background: #fff2e8;
  color: #ff6a00;
}

.blue-tag {
  background: #edf5ff;
  color: #2b70c9;
}

.cat-tag {
  background: #fff8eb;
  color: #b86e00;
}

.gc-price {
  font-size: 40rpx;
  font-weight: 800;
  color: #ff6a00;
}

.gc-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #1f2329;
  display: block;
  margin-bottom: 8rpx;
}

.no-mb {
  margin-bottom: 0;
}

.gc-time {
  font-size: 25rpx;
  color: #8d949c;
  display: block;
  margin-bottom: 16rpx;
}

.gc-pills {
  display: flex;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.gc-pill {
  background: #f5f6f8;
  color: #4e5969;
  font-size: 23rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
}

.gc-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 18rpx;
  border-top: 1rpx solid #f2f4f7;
}

.gc-foot {
  font-size: 23rpx;
  color: #8d949c;
}

.gc-btn {
  background: #ff6a00;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 700;
  padding: 12rpx 28rpx;
  border-radius: 18rpx;
  margin: 0;
  line-height: 1.4;
}

.gc-btn::after {
  border: none;
}

/* 服务单列表（PDF 第 9 页） */
.date-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 22rpx;
}

.date-picker {
  flex: 1;
  background: #ffffff;
  border-radius: 18rpx;
  padding: 18rpx 24rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 700;
}

.week-pill {
  background: #ffffff;
  border-radius: 18rpx;
  padding: 18rpx 28rpx;
  font-size: 26rpx;
}

.so-no {
  font-size: 23rpx;
  color: #8d949c;
}

.so-mid {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 22rpx;
}

.so-line {
  font-size: 25rpx;
  color: #4e5969;
  display: block;
  margin-top: 8rpx;
}

.so-right {
  text-align: right;
}

.so-lbl {
  font-size: 23rpx;
  color: #8d949c;
  display: block;
}

.so-val {
  font-size: 40rpx;
  font-weight: 800;
  color: #ff6a00;
}

.so-timer {
  font-size: 36rpx;
  font-weight: 800;
  color: #19b37b;
}

.so-actions {
  display: flex;
  gap: 18rpx;
}

.so-outline, .so-primary, .so-green, .so-blue-outline {
  flex: 1;
  height: 78rpx;
  line-height: 78rpx;
  font-size: 26rpx;
  font-weight: 700;
  border-radius: 18rpx;
  margin: 0;
}

.so-outline {
  background: #ffffff;
  color: #ff6a00;
  border: 2rpx solid #ffb480;
}

.so-primary {
  background: #ff6a00;
  color: #ffffff;
}

.so-green {
  background: #19b37b;
  color: #ffffff;
}

.so-blue-outline {
  background: #ffffff;
  color: #2b70c9;
  border: 2rpx solid #91caff;
}

/* 工作台·我的（PDF 第 4 页） */
.w-top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 22rpx;
}

.w-brand-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #ff6a00;
  display: block;
}

.w-brand-sub {
  font-size: 22rpx;
  color: #8d949c;
}

.switch-customer-pill {
  background: #fff2e8;
  color: #7c3a12;
  font-size: 23rpx;
  font-weight: 700;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
}

.w-profile-card {
  display: flex;
  align-items: center;
}

.w-avatar-circle {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #fff2e8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-right: 20rpx;
}

.w-p-main {
  flex: 1;
}

.w-p-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.income-hero-card {
  background: linear-gradient(135deg, #43220d 0%, #b34d08 100%);
  border-radius: 28rpx;
  padding: 32rpx;
  color: #ffffff;
  margin-bottom: 22rpx;
}

.ih-lbl {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.ih-amt {
  font-size: 52rpx;
  font-weight: 800;
  display: block;
  margin: 10rpx 0 22rpx;
}

.ih-stats {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

.ih-hi {
  color: #ffca99;
  font-weight: 800;
  margin-left: 6rpx;
}

.card-h {
  font-size: 30rpx;
  font-weight: 800;
  color: #1f2329;
}

.dep-row {
  display: flex;
  justify-content: space-between;
  font-size: 25rpx;
  margin: 14rpx 0;
}

.dep-mid {
  font-weight: 700;
}

.dep-bar {
  height: 14rpx;
  background: #f0f2f5;
  border-radius: 999rpx;
  overflow: hidden;
}

.dep-fill {
  height: 100%;
  background: #ff6a00;
}

.mini-timeline {
  display: flex;
  justify-content: space-between;
  margin: 24rpx 0;
  font-size: 21rpx;
  color: #8d949c;
}

.mt-node {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.mt-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #dcdfe6;
}

.mt-dot.green {
  background: #19b37b;
}

.mt-dot.orange {
  background: #ff6a00;
}

.dual-entry-row {
  display: flex;
  gap: 18rpx;
}

.half-entry {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 27rpx;
  font-weight: 700;
}

.tool-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  margin-top: 22rpx;
}

.tool-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.tool-ico {
  font-size: 42rpx;
}

.tool-txt {
  font-size: 24rpx;
  color: #333842;
}

.orange-txt {
  color: #ff6a00 !important;
  font-weight: 700;
}

.bottom-placeholder {
  height: 140rpx;
}

/* 底部导航 */
.worker-tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 124rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: space-around;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.wt-item, .wt-center {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.wt-ico {
  font-size: 36rpx;
}

.wt-lbl {
  font-size: 21rpx;
  color: #8d949c;
  margin-top: 4rpx;
}

.wt-item.active .wt-lbl {
  color: #ff6a00;
  font-weight: 700;
}

.wt-center-btn {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: #ff6a00;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  margin-top: -28rpx;
  box-shadow: 0 6rpx 16rpx rgba(255, 106, 0, 0.35);
}
