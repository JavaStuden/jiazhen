<view class="login-container">
  <!-- 顶部沉浸式实景头图与品牌区（完全对应图四 4.jpg） -->
  <view class="hero-section">
    <image class="hero-bg" src="/images/login_hero.jpg" mode="aspectFill"></image>
    <view class="hero-mask"></view>
    
    <view class="brand-header">
      <view class="brand-title-wrap">
        <image class="brand-logo" src="/images/logo.jpg" mode="aspectFit"></image>
        <text class="brand-name">太禾行</text>
      </view>
      <text class="brand-subtitle">专业家政与养老服务平台</text>
      <view class="brand-slogan-wrap">
        <text class="brand-slogan">用心服务 让生活更美好 ♡</text>
      </view>
    </view>
  </view>

  <!-- 浮层表单卡片 -->
  <view class="card-sheet">
    <view class="phone-auth-note">使用微信手机号授权完成身份验证</view>

    <button class="primary-btn login-btn" bindtap="handleLogin">
      阅读协议并继续
    </button>
    <button class="primary-btn login-btn" open-type="getPhoneNumber" bindgetphonenumber="handleWechatLogin" loading="{{busy}}" disabled="{{busy}}">
      微信手机号快捷登录
    </button>

    <!-- 角色选择双卡片（平铺左右并列，完全还原图四 4.jpg） -->
    <view class="role-grid">
      <!-- 雇主卡片 -->
      <view 
        class="role-card customer-card {{selectedRole === 'customer' ? 'active' : ''}}"
        bindtap="selectRole"
        data-role="customer"
      >
        <view class="corner-check" wx:if="{{selectedRole === 'customer'}}">
          <text class="check-mark">✓</text>
        </view>
        <view class="role-avatar customer-avatar">
          <text class="avatar-icon">🏠</text>
        </view>
        <text class="role-title">我是雇主</text>
        <text class="role-desc">找保姆、月嫂、护理\n家政保洁等服务</text>
      </view>

      <!-- 服务人员卡片 -->
      <view 
        class="role-card worker-card {{selectedRole === 'worker' ? 'active' : ''}}"
        bindtap="selectRole"
        data-role="worker"
      >
        <view class="corner-check worker-corner-check" wx:if="{{selectedRole === 'worker'}}">
          <text class="check-mark">✓</text>
        </view>
        <view class="role-avatar worker-avatar">
          <text class="avatar-icon">👩🏻‍🍳</text>
        </view>
        <text class="role-title">我是服务人员</text>
        <text class="role-desc">接单赚钱\n自主安排时间</text>
      </view>
    </view>

    <!-- 底部协议勾选 -->
    <view class="agreement-row" bindtap="toggleAgreement">
      <view class="checkbox {{agreed ? 'checked' : ''}}">
        <text wx:if="{{agreed}}" class="check-icon">✓</text>
      </view>
      <text class="agreement-text">
        我已阅读并同意<text class="link" catchtap="viewAgreement">《用户协议》</text>及<text class="link" catchtap="viewPrivacy">《隐私政策》</text>
      </text>
    </view>

    <!-- 游客快速进入 -->
    <view class="guest-entry">
      <text class="guest-text" bindtap="openAgreementSheetPreview">查看平台协议确认页</text>
      <text class="guest-sep">·</text>
      <text class="guest-text" bindtap="enterDirectly">先逛逛，进入首页 ›</text>
    </view>
  </view>

  <!-- 平台协议确认底部弹窗（对应雇主端 PDF 第 2 页 / 服务端 PDF 第 1 页） -->
  <view class="sheet-mask" wx:if="{{showAgreementSheet}}" bindtap="closeAgreementSheet">
    <view class="agreement-sheet" catchtap="true">
      <view class="sheet-handle"></view>
      <view class="sheet-role-pill">
        <text>{{selectedRole === 'customer' ? '雇主端' : '服务人员端'}}</text>
      </view>
      <text class="sheet-title">{{selectedRole === 'customer' ? '平台协议确认' : '服务人员协议确认'}}</text>
      <text class="sheet-sub">首次使用须阅读并确认以下协议</text>

      <view class="rule-list">
        <view class="rule-item" bindtap="viewRuleDetail" data-title="用户协议与隐私政策">
          <view class="rule-check">✓</view>
          <text class="rule-name">用户协议与隐私政策</text>
          <text class="rule-arrow">›</text>
        </view>
        <view class="rule-item" bindtap="viewRuleDetail" data-title="{{selectedRole === 'customer' ? '平台服务规则' : '服务人员入驻及接单规则'}}">
          <view class="rule-check">✓</view>
          <text class="rule-name">{{selectedRole === 'customer' ? '平台服务规则' : '服务人员入驻及接单规则'}}</text>
          <text class="rule-arrow">›</text>
        </view>
        <view class="rule-item" bindtap="viewRuleDetail" data-title="{{selectedRole === 'customer' ? '交易、售后与沟通规则' : '平台履约与保证金规则'}}">
          <view class="rule-check">✓</view>
          <text class="rule-name">{{selectedRole === 'customer' ? '交易、售后与沟通规则' : '平台履约与保证金规则'}}</text>
          <text class="rule-arrow">›</text>
        </view>
      </view>

      <view class="force-notice">
        <view class="force-icon">🛡️</view>
        <view class="force-body">
          <text class="force-title">强制确认说明</text>
          <text class="force-desc">平台更新重要规则时将再次弹窗确认；\n未确认前不能发布任务或接单。</text>
        </view>
      </view>

      <view class="sheet-agree-row" bindtap="toggleSheetConfirm">
        <view class="checkbox {{sheetConfirmed ? 'checked' : ''}}">
          <text wx:if="{{sheetConfirmed}}" class="check-icon">✓</text>
        </view>
        <text class="sheet-agree-text">我已阅读并同意以上全部协议</text>
      </view>

      <button class="primary-btn sheet-confirm-btn" bindtap="confirmAgreementAndContinue">
        同意并继续
      </button>
      <text class="sheet-trace">协议内容、版本及确认时间由平台留痕</text>
      <view class="sheet-cancel" bindtap="closeAgreementSheet">取消</view>
    </view>
  </view>
</view>
