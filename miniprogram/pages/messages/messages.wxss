page {
  background-color: #f7f8fa;
  min-height: 100vh;
}

.container {
  padding: 20rpx 28rpx 60rpx;
}

.card {
  background: #ffffff;
  border-radius: 26rpx;
  padding: 26rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #eceef2;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.03);
}

.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.brand-left {
  display: flex;
  align-items: center;
}

.b-logo {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.b-name {
  font-size: 36rpx;
  font-weight: 800;
  color: #ff6a00;
  display: block;
  line-height: 1.1;
}

.b-sub {
  font-size: 24rpx;
  color: #1f2329;
  font-weight: 600;
}

.read-all {
  font-size: 26rpx;
  color: #d45a00;
  font-weight: 600;
}

.cat-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  padding: 30rpx 14rpx;
}

.cat-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.cat-ico {
  font-size: 44rpx;
}

.cat-lbl {
  font-size: 25rpx;
  font-weight: 600;
  color: #1f2329;
}

.cat-badge {
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 700;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sec-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 16rpx 0 20rpx;
}

.sec-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #1f2329;
}

.sec-filter {
  background: #ffffff;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #4e5969;
  border: 1rpx solid #e5e6eb;
}

.msg-card {
  display: flex;
  align-items: center;
}

.m-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 22rpx;
  flex-shrink: 0;
}

.m-body {
  flex: 1;
}

.m-top {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.m-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #1f2329;
}

.m-time {
  font-size: 22rpx;
  color: #8d949c;
}

.m-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.m-desc {
  font-size: 24rpx;
  color: #646a73;
}

.m-badge {
  background: #ff6a00;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 700;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.history-btn {
  margin-top: 24rpx;
  background: #ffffff;
  color: #ff6a00;
  border: 2rpx solid #ffb480;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 700;
  height: 84rpx;
  line-height: 84rpx;
}

/* 三方沟通室（PDF 第 15 页） */
.chat-sub-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.back-link {
  font-size: 26rpx;
  color: #ff6a00;
  font-weight: 700;
}

.order-no-txt {
  font-size: 24rpx;
  color: #8d949c;
}

.participants-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.part-item {
  display: flex;
  align-items: center;
}

.part-avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

.part-role {
  font-size: 20rpx;
  color: #8d949c;
  display: block;
}

.part-name {
  font-size: 26rpx;
  font-weight: 800;
  color: #1f2329;
}

.online-status {
  font-size: 22rpx;
  color: #19b37b;
  font-weight: 700;
}

.chat-time-div {
  text-align: center;
  font-size: 22rpx;
  color: #8d949c;
  margin: 16rpx 0 24rpx;
}

.chat-stream {
  display: flex;
  flex-direction: column;
  gap: 26rpx;
}

.msg-row {
  display: flex;
  align-items: flex-start;
}

.right-row {
  justify-content: flex-end;
}

.chat-avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.right-avatar {
  margin-right: 0;
  margin-left: 16rpx;
}

.bubble-col {
  max-width: 74%;
  display: flex;
  flex-direction: column;
}

.sender-label {
  font-size: 22rpx;
  color: #8d949c;
  margin-bottom: 6rpx;
}

.chat-bubble {
  padding: 22rpx 26rpx;
  border-radius: 22rpx;
  font-size: 27rpx;
  line-height: 1.48;
}

.white-bubble {
  background: #ffffff;
  color: #1f2329;
  border: 1rpx solid #eceef2;
}

.orange-bubble {
  background: #ff6a00;
  color: #ffffff;
}

.adjust-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 26rpx;
  margin-top: 16rpx;
  border: 1rpx solid #eceef2;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.adj-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}

.adj-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #1f2329;
}

.adj-pill {
  border: 1rpx solid #ffb480;
  color: #d45a00;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.adj-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 25rpx;
}

.adj-lbl {
  color: #8d949c;
}

.adj-val {
  color: #1f2329;
  font-weight: 700;
}

.adj-price {
  color: #ff6a00;
  font-weight: 800;
  font-size: 28rpx;
}

.adj-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.adj-reject, .adj-agree {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 25rpx;
  border-radius: 16rpx;
  margin: 0;
}

.adj-reject {
  background: #ffffff;
  color: #ff6a00;
  border: 1rpx solid #ffb480;
}

.adj-agree {
  background: #ff6a00;
  color: #ffffff;
  font-weight: 700;
}

.adj-reject::after, .adj-agree::after {
  border: none;
}

.chat-warn-bar {
  margin-top: 30rpx;
  background: #fff8f3;
  color: #b85d19;
  text-align: center;
  font-size: 23rpx;
  padding: 16rpx;
  border-radius: 14rpx;
}

.bottom-placeholder {
  height: 130rpx;
}

.chat-input-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 116rpx;
  background: #ffffff;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  box-shadow: 0 -4rpx 18rpx rgba(0, 0, 0, 0.05);
}

.plus-circle, .mic-circle {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  border: 1rpx solid #dcdfe6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #646a73;
}

.chat-input {
  flex: 1;
  height: 72rpx;
  background: #f5f6f8;
  border-radius: 999rpx;
  padding: 0 28rpx;
  font-size: 27rpx;
}

.send-btn {
  background: #ff6a00;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  margin: 0;
}

.send-btn::after {
  border: none;
}
