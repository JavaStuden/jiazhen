<view class="container">
  <!-- 雇主信息卡片 -->
  <view class="user-card">
    <view class="avatar-box">
      <image class="avatar-img" src="/images/logo.jpg" mode="aspectFill"></image>
      <view class="online-dot"></view>
    </view>
    <view class="user-meta">
      <view class="user-title-row">
        <text class="user-name">陈女士</text>
        <view class="credit-tag">信用雇主 100分</view>
      </view>
      <text class="user-phone">138****2068 · 已实名认证</text>
    </view>
    <view class="switch-role-btn" bindtap="goToLogin">
      <text class="switch-text">切换端</text>
    </view>
  </view>

  <!-- 资金与预算账户概览卡片 -->
  <view class="wallet-card">
    <view class="wallet-top">
      <text class="wallet-label">预算账户余额 (元)</text>
      <text class="wallet-amount">¥1,280.00</text>
    </view>
    <view class="wallet-divider"></view>
    <view class="wallet-stats">
      <view class="stat-col">
        <text class="stat-num">¥168</text>
        <text class="stat-name">待结算</text>
      </view>
      <view class="stat-col">
        <text class="stat-num">26 单</text>
        <text class="stat-name">累计发布</text>
      </view>
      <view class="stat-col">
        <text class="stat-num">¥860</text>
        <text class="stat-name">可开发票</text>
      </view>
    </view>
  </view>

  <!-- 常用功能区 -->
  <view class="menu-card">
    <view class="menu-heading">我的服务</view>
    <view class="menu-grid">
      <view class="menu-item" bindtap="goOrders">
        <text class="menu-icon">📄</text>
        <text class="menu-text">我的订单</text>
      </view>
      <view class="menu-item" bindtap="showFeatureToast" data-name="常用地址">
        <text class="menu-icon">📍</text>
        <text class="menu-text">常用地址</text>
      </view>
      <view class="menu-item" bindtap="showFeatureToast" data-name="发票管理">
        <text class="menu-icon">🧾</text>
        <text class="menu-text">发票管理</text>
      </view>
      <view class="menu-item" bindtap="showFeatureToast" data-name="优惠券">
        <text class="menu-icon">🎟️</text>
        <text class="menu-text">优惠券中心</text>
      </view>
      <view class="menu-item" bindtap="showFeatureToast" data-name="企业认证">
        <text class="menu-icon">🏢</text>
        <text class="menu-text">企业认证</text>
      </view>
      <view class="menu-item" bindtap="contactService">
        <text class="menu-icon">🎧</text>
        <text class="menu-text">客服与安全</text>
      </view>
      <view class="menu-item" bindtap="showFeatureToast" data-name="城市合伙人">
        <text class="menu-icon">🤝</text>
        <text class="menu-text">城市合伙人</text>
      </view>
      <view class="menu-item" bindtap="showFeatureToast" data-name="账号设置">
        <text class="menu-icon">⚙️</text>
        <text class="menu-text">账号与安全</text>
      </view>
    </view>
  </view>

  <!-- 切换端与重新登录操作 -->
  <view class="action-section">
    <button class="worker-mode-btn" bindtap="switchWorker">
      切换至服务人员端（阿姨/师傅工作台）
    </button>
    <button class="logout-btn" bindtap="goToLogin">
      退出 / 重新选择身份
    </button>
  </view>
</view>
