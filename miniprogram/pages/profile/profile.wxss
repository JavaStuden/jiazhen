page {
  background-color: #f7f8fa;
  min-height: 100vh;
}

.container {
  padding: 20rpx 28rpx 60rpx;
  box-sizing: border-box;
}

.top-brand-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 22rpx;
}

.tb-left {
  display: flex;
  align-items: center;
}

.tb-logo {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  margin-right: 14rpx;
}

.tb-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #ff6a00;
  display: block;
  line-height: 1.1;
}

.tb-sub {
  font-size: 22rpx;
  color: #8d949c;
}

/* 用户卡片 */
.user-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx 28rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid #eceef2;
  margin-bottom: 24rpx;
}

.avatar-box {
  width: 104rpx;
  height: 104rpx;
  margin-right: 22rpx;
  flex-shrink: 0;
}

.text-avatar {
  width: 100%;
  height: 100%;
  border-radius: 26rpx;
  background: #fff2e8;
  color: #d45a00;
  font-size: 46rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.user-meta {
  flex: 1;
}

.user-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.user-name {
  font-size: 36rpx;
  font-weight: 800;
  color: #1a2233;
  margin-right: 14rpx;
}

.credit-tag {
  background: #fff0e5;
  color: #d46b08;
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

.user-phone {
  font-size: 23rpx;
  color: #8d949c;
}

.switch-role-btn {
  background: #fff2e8;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
}

.switch-text {
  font-size: 23rpx;
  color: #7c3a12;
  font-weight: 700;
}

/* 钱包与预算账户 */
.wallet-card {
  background: linear-gradient(135deg, #2b2d38 0%, #1e2029 100%);
  border-radius: 28rpx;
  padding: 32rpx 30rpx;
  color: #ffffff;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(30, 36, 48, 0.2);
}

.wallet-top {
  display: flex;
  flex-direction: column;
  margin-bottom: 22rpx;
}

.wallet-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
  margin-bottom: 8rpx;
}

.wallet-amount {
  font-size: 48rpx;
  font-weight: 800;
  color: #ffffff;
}

.wallet-divider {
  width: 100%;
  height: 1rpx;
  background: rgba(255, 255, 255, 0.12);
  margin-bottom: 22rpx;
}

.wallet-stats {
  display: flex;
  justify-content: space-between;
}

.stat-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 28rpx;
  font-weight: 700;
  color: #ffb076;
  margin-bottom: 6rpx;
}

.stat-name {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.65);
}

/* 菜单区 */
.menu-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 22rpx;
  border: 1rpx solid #eceef2;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.menu-heading-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.menu-heading {
  font-size: 32rpx;
  font-weight: 800;
  color: #1a2233;
}

.menu-more {
  font-size: 24rpx;
  color: #8d949c;
}

.menu-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 28rpx 10rpx;
}

.menu-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.menu-icon {
  font-size: 42rpx;
  margin-bottom: 12rpx;
}

.menu-text {
  font-size: 24rpx;
  color: #333842;
  font-weight: 500;
}

.coop-row {
  display: flex;
  gap: 18rpx;
  margin-top: 20rpx;
}

.coop-box {
  flex: 1;
  background: #f8f9fb;
  border-radius: 18rpx;
  padding: 22rpx 20rpx;
  display: flex;
  align-items: center;
}

.coop-ico {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.coop-txt {
  flex: 1;
  font-size: 26rpx;
  font-weight: 700;
  color: #1f2329;
}

.coop-arr {
  color: #8d949c;
}

.msg-center-banner {
  background: linear-gradient(90deg, #ff8b2b 0%, #ff6a00 100%);
  border-radius: 26rpx;
  padding: 28rpx 30rpx;
  color: #ffffff;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 22rpx;
}

.mcb-title {
  font-size: 30rpx;
  font-weight: 800;
  display: block;
  margin-bottom: 6rpx;
}

.mcb-sub {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.88);
}

.mcb-pill {
  background: #ffffff;
  color: #ff6a00;
  font-size: 24rpx;
  font-weight: 700;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
}

.entry-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f2f4f7;
}

.entry-line.last-el {
  border-bottom: none;
  padding-bottom: 0;
}

.el-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2329;
  display: block;
}

.el-sub {
  font-size: 22rpx;
  color: #d45a00;
  margin-top: 6rpx;
  display: block;
}

.el-more {
  font-size: 24rpx;
  color: #8d949c;
}

/* 底部操作 */
.action-section {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 10rpx;
}

.worker-mode-btn {
  background: #e8f8f0;
  color: #19b37b;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 20rpx;
  height: 88rpx;
  line-height: 88rpx;
  border: 1rpx solid #c2eed9;
}

.worker-mode-btn::after {
  border: none;
}

.logout-btn {
  background: #ffffff;
  color: #8d949c;
  font-size: 26rpx;
  border-radius: 20rpx;
  height: 80rpx;
  line-height: 80rpx;
  border: 1rpx solid #e3e6eb;
}

.logout-btn::after {
  border: none;
}
